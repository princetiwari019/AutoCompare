# AutoCompare Server Production Environment Template
NODE_ENV=production
PORT=5000

# Database Configuration (Supports MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/autocompare
MONGO_URI=mongodb://127.0.0.1:27017/autocompare

# Client Origin Configuration
CLIENT_URL=http://localhost:3000

# Security Credentials
ADMIN_EMAIL=admin@autocompare.com
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=your_super_secure_jwt_secret_here

# AI Advisor Configuration (Optional)
AI_API_KEY=your_optional_gemini_api_key_here

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=autocompare/vehicles
